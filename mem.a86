;*-------------------------------------------------------------------------
;  MEM.A86 - Native CP/M-86 memory viewer
;
;  Uses the CP/M-86 BDOS memory-control query (INT E0h, function 35h) to
;  obtain the current program allocation.  It separately reports installed
;  PC memory through the CP/M-family appropriate path: the BIOS data area on
;  CCP/M 3.x, otherwise INT 12h (capped at 640 KiB).
;
;  This is intentionally distinct from DOSMEM, whose PSP:0002h and
;  INT 21h conventions apply only to DOS PC-MODE programs.
;-------------------------------------------------------------------------

            title   'Memory'

            cseg
            cli
            mov     ax,ds
            mov     ss,ax
            mov     sp,offset stk + 128
            sti

            mov     cx,ds
            mov     es,cx
            mov     dx,offset mcb
            mov     cl,35h
            int     0E0h
            mov     ax, word ptr mlen
            mov     cl,6
            shr     ax, cl
            inc     ax
            mov     bx,10
            call    print_uint16
            lea     si, msg_sep
            call    print_str  
            mov     cx,0Ch
            int     0E0h
            cmp     ax,1430h
            jz      ccpm3x
            cmp     ax,1431h
            jz      ccpm3x
            int     12h
            cmp     ax,640
            ja      fixax
            jmp     prram
ccpm3x: 
            mov     bx,40h
            mov     es,bx
            mov     bx,13h
            mov     ax, es:[bx]
fixax:      
            mov     ax, 640
prram:
            mov     bx,10
            call    print_uint16
            lea     si, msg_nl
            call    print_str  
            call    quit

include tinylib.a86

            dseg

mcb         dw     0
mlen        dw     65534
mext        db     0
msg_sep     db     'K/',0
msg_nl      db     'K',13,10,0

stk         rw      64              ; 128 bytes program stack
            end
