        DB      '90  '
        DB      90H,91H,92H,93H,94H,95H,96H,97H
        DB      98H,99H,9AH,9BH,9CH,9DH,9EH,9FH,13,10

        DB      'A0  '
        DB      0A0H,0A1H,0A2H,0A3H,0A4H,0A5H,0A6H,0A7H
        DB      0A8H,0A9H,0AAH,0ABH,0ACH,0ADH,0AEH,0AFH,13,10

        DB      'B0  '
        DB      0B0H,0B1H,0B2H,0B3H,0B4H,0B5H,0B6H,0B7H
        DB      0B8H,0B9H,0BAH,0BBH,0BCH,0BDH,0BEH,0BFH,13,10

        DB      'C0  '
        DB      0C0H,0C1H,0C2H,0C3H,0C4H,0C5H,0C6H,0C7H
        DB      0C8H,0C9H,0CAH,0CBH,0CCH,0CDH,0CEH,0CFH,13,10

        DB      'D0  '
        DB      0D0H,0D1H,0D2H,0D3H,0D4H,0D5H,0D6H,0D7H
        DB      0D8H,0D9H,0DAH,0DBH,0DCH,0DDH,0DEH,0DFH,13,10

        DB      'E0  '
        DB      0E0H,0E1H,0E2H,0E3H,0E4H,0E5H,0E6H,0E7H
        DB      0E8H,0E9H,0EAH,0EBH,0ECH,0EDH,0EEH,0EFH,13,10

        DB      'F0  '
