        CSEG

        MOV     DX,OFFSET FIRST
        MOV     CL,9
        INT     224

        MOV     DL,24H
        MOV     CL,2
        INT     224

        MOV     DX,OFFSET SECOND
        MOV     CL,9
        INT     224

        MOV     CL,0
        MOV     DL,0
        INT     224

        DSEG
        ORG     100H

FIRST:
        DB      '    0123456789ABCDEF',13,10
        DB      '20  ',20H,21H,22H,23H,'$'

SECOND:
        DB      25H,26H,27H,28H,29H,2AH,2BH
        DB      2CH,2DH,2EH,2FH,13,10

        DB      '30  '
        DB      30H,31H,32H,33H,34H,35H,36H,37H
        DB      38H,39H,3AH,3BH,3CH,3DH,3EH,3FH,13,10

