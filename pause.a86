            title   'Pause for Key'

            cseg     
            cli
            mov     ax,ds
            mov     ss,ax
            mov     sp,offset stk + 128
            sti
            mov     cx,ds
            mov     es,cx
            mov     dx, offset msg_hdr
            mov     cl,9            
            int     0E0h    
pause:
            mov     cl,6
            mov     dl,0ffh         ; nonblocking raw input on CP/M-86 and CCP/M-86
            int     0E0h
            or      al,al
            jz      pause
got_key:
            xor     ax,ax
            mov     dx,offset msg_clear
            mov     cl,9
            int     0E0h
            xor     cx,cx
            int     0E0h
       
            dseg    
msg_hdr     db      'Press any key to continue...','$'
msg_clear   db      13,27,'K$'
stk         rw      64              ; 128 bytes program stack
        end
